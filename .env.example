PUBLIC_HOST=send.example.com
PUBLIC_BASE_URL=https://send.example.com
SERVER_NAME=GlobalSend
# Serve the Web client from the same center. Set false for API/relay only.
WEB_ENABLED=true
MAX_FILE_SIZE=2147483648
TOTAL_QUOTA=10737418240
TTL_SECONDS=86400
DISK_RESERVE=67108864
LOG_LEVEL=info
# Optional STUN discovery. Empty keeps host candidates only (no external STUN).
# Self-hosted: enable Compose profile "stun" and allow inbound UDP 3478 first.
# Example only; replace with your reachable IP or DNS name:
# STUN_URLS=stun:123.207.180.163:3478
# Multiple stun:/stuns: URLs may be comma-separated. TURN is not used here.
STUN_URLS=
