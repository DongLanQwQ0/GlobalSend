	<array><dict>
		<key>CFBundleURLName</key><string>GlobalSend 分享</string>
		<key>CFBundleURLSchemes</key><array><string>globalsend</string></array>
	</dict></array>
	<key>CFBundleDocumentTypes</key>
	<array><dict>
		<key>CFBundleTypeName</key><string>文件</string>
		<key>CFBundleTypeRole</key><string>Viewer</string>
		<key>LSHandlerRank</key><string>Alternate</string>
		<key>LSItemContentTypes</key><array><string>public.item</string><string>public.content</string><string>public.data</string><string>public.directory</string></array>
	</dict></array>
